package com.user;

/*
Contacts App : UC-01 User Registration
This class represents user account types.
It does the following things:
    - Defines FREE and PREMIUM users
    - Stores maximum allowed contacts for each type

@author Developer
@version 1.0
*/

public enum UserType {
    FREE(100),
    PREMIUM(1000);

    private int maxContacts;

    UserType(int maxContacts) {
        this.maxContacts = maxContacts;
    }

    public int getMaxContacts() {
        return maxContacts;
    }
}